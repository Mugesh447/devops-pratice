day 01 basic git command
git --version  -(Git Version Check)
git config --global user,name "Name" -(Username set)
git config --global user.eamil "email" -(Email Set)
git init -(New Git Repo create)
git status -(current status check)
git add .-(All files staging-ku add)
git add filename -(specific fileadd)
git commit -m "message" -(Changes Commit)
git log-(Commit history)
git log --oneline (Short commit history)
----------------------------------------------------------------------------
day-02 advanced git command
git branch -(List branches)
git branch branch-name -(Create new branch)
git switch branch-name -(Switch branch)
git switch -c branch-name-(Create and Switch branch)
git merge branch-name-(Merge Branch)
git branch -d branch-name-(Delete Branch)
git remote -v -(Check remote repository)
git fetch-(Download remote changes)
git pull-(Fetch and Merge Changes)
git push origin main-(Push Changes to GitHub)
git clone repistory-url -(Clone repistory)
git diff-(Check file changes)
git stash-(Temporarily save changes)
